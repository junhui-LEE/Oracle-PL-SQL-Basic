CREATE TABLE EMPS_IT AS SELECT * FROM EMPLOYEES WHERE 1=2
;

SELECT * FROM employees
;

INSERT INTO emps_it(employee_id, first_name, last_name, email, hire_date, job_id)
VALUES (105, 'David', 'Kim', 'DAVIDKIM', '06/03/04', 'IT_PROG')
;

SELECT * FROM emps_it
;

SELECT * 
FROM employees 
WHERE 1=1
-- AND employee_id = 105 
AND job_id = 'IT_PROG'
;

MERGE INTO emps_it A
USING(SELECT * FROM employees WHERE job_id = 'IT_PROG') B
ON(A.employee_id = B.employee_id)
WHEN MATCHED THEN
UPDATE SET
A.phone_number = B.phone_number,
A.hire_date = B.hire_date,
A.job_id = B.job_id,
A.salary = B.salary,
A.commission_pct = B.commission_pct,
A.manager_id = B.manager_id,
A.department_id = B.department_id
WHEN NOT MATCHED THEN
INSERT 
VALUES
(
B.employee_id, B.first_name, B.last_name, B.email, B.phone_number, B.hire_date,
B.job_id, B.salary, B.commission_pct, B.manager_id, B.department_id)
;

SELECT *
FROM emps_it
;
ROLLBACK;




















